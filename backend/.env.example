# 茶·图鉴 后端环境变量示例
# 复制为 .env 后按本地环境修改；.env 不进 Git（.gitignore 已覆盖）

# === 基础 ===
DEBUG=true

# === 数据库（MySQL 5.7.19） ===
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=tea_guide

# === 会话 ===
# 上线前必须轮换为足够长的随机字符串（安全 P0，见 AGENTS.md §13）
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
SESSION_EXPIRE_DAYS=30

# === 管理员初始账号（上线前必须轮换） ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
